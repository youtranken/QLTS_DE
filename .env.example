# QLTS — copy file này thành `.env` rồi đổi các giá trị CHANGE_ME (NFR-12: .env không commit)

# --- Postgres ---
POSTGRES_USER=qlts
# LƯU Ý: password được nội suy vào DATABASE_URL — chỉ dùng chữ/số/-/_
# (ký tự @ / # % : sẽ phá URL kết nối)
POSTGRES_PASSWORD=CHANGE_ME_pg_password
POSTGRES_DB=qlts

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password
# maxmemory phải < REDIS_MEM_LIMIT; policy noeviction (BullMQ yêu cầu)
REDIS_MAXMEMORY=96mb

# --- App ---
# NODE_ENV: production | development | test
NODE_ENV=production
# AUTH_DEV_MODE chỉ nhận đúng chuỗi `true`/`false` (TRUE/1/yes = coi như tắt).
# =true CHỈ được phép khi NODE_ENV=development|test — sai môi trường là app TỪ CHỐI KHỞI ĐỘNG (fail-closed)
AUTH_DEV_MODE=false
# Cổng duy nhất publish ra host (nginx serve SPA + proxy /api)
WEB_PORT=8080

# --- Ngân sách RAM 2GB (AC 2) — chỉnh nếu cần, tổng không vượt 2GB kể cả worker (3.5a) ---
POSTGRES_MEM_LIMIT=512m
API_MEM_LIMIT=384m
REDIS_MEM_LIMIT=128m
WEB_MEM_LIMIT=64m
