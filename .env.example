# QLTS — copy file này thành `.env` rồi đổi các giá trị CHANGE_ME (NFR-12: .env không commit)

# --- Postgres ---
POSTGRES_USER=qlts
# LƯU Ý: password được nội suy vào DATABASE_URL — chỉ dùng chữ/số/-/_
# (ký tự @ / # % : sẽ phá URL kết nối)
POSTGRES_PASSWORD=CHANGE_ME_pg_password
POSTGRES_DB=qlts

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password
# maxmemory phải < REDIS_MEM_LIMIT; policy noeviction (BullMQ yêu cầu)
REDIS_MAXMEMORY=384mb

# --- App ---
# NODE_ENV: production | development | test
NODE_ENV=production
# AUTH_DEV_MODE chỉ nhận đúng chuỗi `true`/`false` (TRUE/1/yes = coi như tắt).
# =true CHỈ được phép khi NODE_ENV=development|test — sai môi trường là app TỪ CHỐI KHỞI ĐỘNG (fail-closed)
AUTH_DEV_MODE=false

# --- PMH ID (SSO) — story 1.2. Client DEV/PROD TÁCH RIÊNG (NFR-12), SA cấp ---
# Dev: https://id.pmh.com.vn:9443/oidc (hosts trỏ 127.0.0.1) | Prod: https://id.pmh.com.vn/oidc
PMH_ISSUER_URL=https://id.pmh.com.vn:9443/oidc
PMH_CLIENT_ID=
PMH_CLIENT_SECRET=
PMH_WEBHOOK_SECRET=
# URL gốc app — dùng dựng redirect_uri = {APP_BASE_URL}/api/auth/callback (khai với SA)
# HTTPS bắt buộc cho cookie Secure (AD-8); nginx phục vụ TLS bằng cert *.pmh.com.vn
APP_BASE_URL=https://qlts.pmh.com.vn
# SA cục bộ (break-glass, story 10.1): tài khoản root độc lập SSO — CHỈ dùng để can thiệp/bootstrap.
# Admin (SSO) lo vận hành hằng ngày. BẮT BUỘC — thiếu là app từ chối khởi động. SA CHỈ đến từ đây.
# Sinh hash: cd api && npm run sa:hash -- 'mật-khẩu-mạnh'  (KHÔNG lưu mật khẩu thô ở đâu cả)
LOCAL_SA_USERNAME=sa
LOCAL_SA_PASSWORD_HASH=
# Cert dev tự ký: đặt NODE_EXTRA_CA_CERTS=/path/ca.pem (KHÔNG tắt TLS verify)

# --- SMTP gửi mail (story 5.1, NFR-3/NFR-12) — Gmail Workspace, credential CHỈ ở env ---
# Worker gửi mail nền; SMTP_HOST trống = consumer báo lỗi (badge SA), không nuốt mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Địa chỉ hiển thị người gửi (mặc định = SMTP_USER nếu trống)
SMTP_FROM=

# --- Ngân sách RAM: tổng ≤ 16GB (profile PROD, host ≥18GB) ---
# Tổng 5 service = 16384m. Dev/máy nhỏ: giảm xuống (vd postgres 512m/api 384m/... tổng ~2GB).
POSTGRES_MEM_LIMIT=9216m
API_MEM_LIMIT=4096m
REDIS_MEM_LIMIT=512m
WEB_MEM_LIMIT=512m
# worker nền (story 3.5a) — process thứ 2 cùng image api
WORKER_MEM_LIMIT=2048m

# --- Chatbot Gemini (Epic 12) — free-tier Google AI Studio, KHÔNG cần thẻ ---
# Lấy key ở https://aistudio.google.com/apikey. Thiếu key = tắt phần "gõ câu tự do"
# (chatbot lùi về nút bấm + tìm từ khoá, vẫn chạy). LƯU Ý: khi bật key, câu gõ tự do đi
# qua 2 chặng — chọn tool RỒI soạn câu (RAG); chặng soạn GỬI KẾT QUẢ TOOL (dữ liệu tài sản
# role-scoped: mã máy/cấu hình/người giữ/… tuỳ câu hỏi) sang Google để soạn trả lời tự nhiên.
# Nút bấm/guided KHÔNG đi qua Gemini (render template nội bộ). Không có key = 0 dữ liệu ra ngoài.
GEMINI_API_KEY=

# --- Module file (story 2.8, AD-6) ---
# Trong Docker: compose đã hardcode /data/files (volume filesdata) — KHÔNG cần đặt.
# Chỉ cần khi chạy api NGOÀI Docker (dev/test): trỏ thư mục ghi được bất kỳ.
# FILE_STORAGE_DIR=./data/files
